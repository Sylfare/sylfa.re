---
import { Picture } from "astro:assets";
import validW3C from "@banners/valid-html5.gif";
import nekoweb from "@banners/nekoweb.gif";
import inclusivePride from "@banners/inclusive_pride.gif";
import agender from "@banners/agender.gif";
import asexual from "@banners/asexual.gif";
import adhd from "@banners/adhd.png";
import antinft from "@banners/antinft.gif";
import mandatoryFun from "@banners/mandatory_fun.png";
import queercoded from "@banners/queercoded.png";
import ublockNow from "@banners/ublock-now.png";

import FooterButton from "./FooterButton.astro";



---
</linkTag>
<footer>
    <FooterButton name="validW3C" image={validW3C} href="https://www.youtube.com/watch?v=dQw4w9WgXcQ"/>
    <FooterButton name="nekoweb" image={nekoweb} href="https://nekoweb.org"/>
    <FooterButton name="inclusivePride" image={inclusivePride} />
    <FooterButton name="agender" image={agender} />
    <FooterButton name="asexual" image={asexual} />
    <FooterButton name="adhd" image={adhd} />
    <FooterButton name="antinft" image={antinft} />
    <FooterButton name="mandatoryFun" image={mandatoryFun} />
    <FooterButton name="queercoded" image={queercoded} />
    <FooterButton name="ublockNow" image={ublockNow} href="https://addons.mozilla.org/en-US/firefox/addon/ublock-origin/" />
    
</footer>

<style>
    footer {
        margin-top: .5em;
    }
    footer a {
        text-decoration: none;
    }
</style>