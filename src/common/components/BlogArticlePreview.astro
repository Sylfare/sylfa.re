---
import type { CollectionEntry } from "astro:content";
import Section from "./Section.astro";
import Navigation from "./Navigation.astro";
import { useTranslations } from "../i18n/utils";
type Props = {
    article: CollectionEntry<'blog-fr'>
}
const { article } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const mainPath = t(a=>a.navigation?.blogArticlePath);

---

<Section title={article.data.titre}>
    {article.data.resume && <p>{article.data.resume}</p>}
    <Navigation href={`/${mainPath}/${article.id}`}>{t(a => a.pages?.blog?.seeMore)}</Navigation>
</Section>